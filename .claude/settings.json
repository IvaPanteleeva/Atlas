{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh\"",
            "timeout": 120,
            "statusMessage": "Build / format"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-tests.sh\"",
            "timeout": 300,
            "statusMessage": "Running tests"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["angular-cli"]
}
